<?xml version="1.0" encoding="utf-8"?>
<!-- Welcome screen 2021 print: sunlit sailboat over layered azure sea with golden reflections. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="125dp"
    android:viewportWidth="100"
    android:viewportHeight="125">
    <!-- Coastal summer sky -->
    <path android:pathData="M0,0h100v86h-100z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="0"
                android:endX="50"
                android:endY="86"
                android:type="linear">
                <item android:color="#77B5FF" android:offset="0.0" />
                <item android:color="#BCE0FF" android:offset="0.65" />
                <item android:color="#E8F4FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Sun glow & disc -->
    <path android:pathData="M25,30m-22,0a22,22 0 1,0 44,0a22,22 0 1,0 -44,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="25"
                android:centerY="30"
                android:gradientRadius="22"
                android:type="radial">
                <item android:color="#77FFD966" android:offset="0.0" />
                <item android:color="#00FFD966" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M15,30a10,10 0 1,0 20,0a10,10 0 1,0 -20,0"
        android:fillColor="#FFC93C" />
    <!-- Layered ocean -->
    <path android:pathData="M0,82h100v43h-100z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="82"
                android:endX="50"
                android:endY="125"
                android:type="linear">
                <item android:color="#2E7BFF" android:offset="0.0" />
                <item android:color="#174EB8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Sun shimmer on water -->
    <path
        android:pathData="M15,89h20a1.5,1.5 0 0,1 0,3h-20a1.5,1.5 0 0,1 0,-3z"
        android:fillColor="#FFE380"
        android:fillAlpha="0.55" />
    <path
        android:pathData="M19,96h12a1.2,1.2 0 0,1 0,2.4h-12a1.2,1.2 0 0,1 0,-2.4z"
        android:fillColor="#FFE380"
        android:fillAlpha="0.4" />
    <!-- Gentle waves -->
    <path
        android:pathData="M0,93 q12.5,-4 25,0 t25,0 t25,0 t25,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeAlpha="0.55" />
    <path
        android:pathData="M8,106 q12,-3.5 24,0 t24,0 t24,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:strokeAlpha="0.32" />
    <!-- Boat reflection -->
    <path
        android:pathData="M43,92 H77 L72,97 H48 Z"
        android:fillColor="#0E2C66"
        android:fillAlpha="0.4" />
    <!-- Main sail & jib -->
    <path
        android:pathData="M58,36 L58,76 L82,76 Z"
        android:fillColor="#FFFDF9" />
    <path android:pathData="M55,45 L55,76 L39,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="47"
                android:startY="45"
                android:endX="47"
                android:endY="76"
                android:type="linear">
                <item android:color="#FF6052" android:offset="0.0" />
                <item android:color="#D93626" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Mast & hull -->
    <path
        android:pathData="M56,35h1.8v43h-1.8z"
        android:fillColor="#262436" />
    <path
        android:pathData="M37,79 H83 L76,88 H44 Z"
        android:fillColor="#181615" />
</vector>
