<?xml version="1.0" encoding="utf-8"?>
<!--
  English. Every other language starts from this file.

  To add a language, copy this file to lang/<code>.xml (such as de.xml or pt-BR.xml),
  set name, dir ("rtl" for right to left) and script ("arabic" for Arabic script), and
  translate the text between the tags. Keep the {slots}: the app fills them in.
  Plurals take one <item> per form the language uses: zero, one, two, few, many, other.
  Any word left out comes from English.
-->
